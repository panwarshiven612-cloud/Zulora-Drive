rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions

    // ── Authorization Helper Functions ────────────────────────────────────────

    /** User is signed in (any provider) */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** User is signed in AND their email is verified (Firebase email_verified claim).
     *  Google SSO accounts always have email_verified: true.
     *  Email/Password accounts only pass after the user clicks the verification link.
     *  Admin accounts are always treated as verified regardless.
     */
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    /** Caller owns the resource (matches the document path UID segment) */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** Caller is the Zulora admin account */
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'zulora.help@gmail.com';
    }

    // User profiles & storage metadata
    /** Owner with verified email, or admin (used for write guards) */
    function isVerifiedOwner(userId) {
      return (isOwner(userId) && isEmailVerified()) || isAdmin();
    }


    // ── User Profiles & Storage Metadata ──────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isVerifiedOwner(userId);
      allow update: if isAdmin() || (isVerifiedOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'email', 'photoURL', 'lastLogin',
          'storageUsedBytes', 'usedStorageBytes', 'storageUsed', 'updatedAt'
        ]));
      // Referral reward updates must be exact five-gigabyte increments.
      allow update: if isVerifiedOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'storageLimitBytes', 'storageLimit', 'referralBonusBytes',
          'referredBy', 'referralProcessed', 'updatedAt'
        ]) &&
        getAfter(/databases/$(database)/documents/referrals/$(userId + '_' + request.resource.data.referredBy)).data.newUserUid == userId &&
        getAfter(/databases/$(database)/documents/referrals/$(userId + '_' + request.resource.data.referredBy)).data.referrerUid == request.resource.data.referredBy &&
        request.resource.data.storageLimitBytes == resource.data.storageLimitBytes + 5368709120 &&
        request.resource.data.storageLimit == resource.data.storageLimit + 5368709120 &&
        request.resource.data.referralBonusBytes == resource.data.referralBonusBytes + 5368709120;
      allow update: if isEmailVerified() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'storageLimitBytes', 'storageLimit', 'referralBonusBytes',
          'totalReferrals', 'lastReferralUid', 'updatedAt'
        ]) &&
        request.resource.data.lastReferralUid != null &&
        getAfter(/databases/$(database)/documents/referrals/$(request.resource.data.lastReferralUid + '_' + userId)).data.newUserUid == request.resource.data.lastReferralUid &&
        getAfter(/databases/$(database)/documents/referrals/$(request.resource.data.lastReferralUid + '_' + userId)).data.referrerUid == userId &&
        request.resource.data.storageLimitBytes == resource.data.storageLimitBytes + 5368709120 &&
        request.resource.data.storageLimit == resource.data.storageLimit + 5368709120 &&
        request.resource.data.referralBonusBytes == resource.data.referralBonusBytes + 5368709120 &&
        request.resource.data.totalReferrals == resource.data.totalReferrals + 1;

      // Delete: admin-only hard delete
      allow delete: if isAdmin();

      // User files subcollection
      // ── Per-User Files Subcollection ────────────────────────────────────────
      match /files/{fileId} {
        allow read: if isVerifiedOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
          request.resource.data.userUid == userId &&
          request.resource.data.fileSize <= 524288000;
        allow update: if isVerifiedOwner(userId) &&
          resource.data.userUid == userId &&
          request.resource.data.userUid == userId &&
          request.resource.data.fileSize <= 524288000;
        allow delete: if isVerifiedOwner(userId);
      }
    }

    // Global files collection (for system overview, search, and shared file links)

    // ── Global Files Collection ───────────────────────────────────────────────
    // Used for system-wide search, shared file links, and admin overviews.
    match /files/{fileId} {
      allow create: if isEmailVerified() &&
                       request.resource.data.userUid == request.auth.uid &&
                       request.resource.data.fileSize <= 524288000;
      allow read: if isEmailVerified() &&
                  (resource.data.userUid == request.auth.uid || isAdmin());
      allow update: if isEmailVerified() &&
            (resource.data.userUid == request.auth.uid || isAdmin()) &&
            (request.resource.data.fileSize <= 524288000 || isAdmin());
      allow delete: if isEmailVerified() &&
            (resource.data.userUid == request.auth.uid || isAdmin());
    }

    match /referrals/{referralId} {
      allow create: if isEmailVerified() &&
        request.resource.data.newUserUid == request.auth.uid &&
        request.resource.data.referrerUid != request.auth.uid &&
        request.resource.data.rewardBytes == 5368709120 &&
        referralId == request.resource.data.newUserUid + '_' + request.resource.data.referrerUid;
      allow read: if isAdmin() ||
        (isEmailVerified() && (resource.data.newUserUid == request.auth.uid || resource.data.referrerUid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Upgrade payment requests

    // ── Upgrade Payment Requests ──────────────────────────────────────────────
    match /upgradeRequests/{requestId} {
      allow create: if isAuthenticated();
      // Only verified users can submit upgrade/payment requests.
      allow create: if isEmailVerified();
      allow read, update, delete: if isAdmin();
    }

  }
}

