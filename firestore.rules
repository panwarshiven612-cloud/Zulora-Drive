rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions

    // ── Authorization Helper Functions ────────────────────────────────────────

    /** User is signed in (any provider) */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** User is signed in AND their email is verified (Firebase email_verified claim).
     *  Google SSO accounts always have email_verified: true.
     *  Email/Password accounts only pass after the user clicks the verification link.
     *  Admin accounts are always treated as verified regardless.
     */
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    /** Caller owns the resource (matches the document path UID segment) */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** Caller is the Zulora admin account */
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'zulora.help@gmail.com';
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'zulora.help@gmail.com';
    }

    // User profiles & storage metadata
    /** Owner with verified email, or admin (used for write guards) */
    function isVerifiedOwner(userId) {
      return (isOwner(userId) && isEmailVerified()) || isAdmin();
    }


    // ── User Profiles & Storage Metadata ──────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      // Reads: any authenticated user can read their own profile doc.
      //   This allows bootstrapUser() to check if the doc exists before
      //   verification completes (needed on first sign-up).
      allow read: if isOwner(userId) || isAdmin();

      // Create / Update: requires verified email to prevent unverified accounts
      //   from persisting data to Firestore.
      allow create, update: if isVerifiedOwner(userId);

      // Delete: admin-only hard delete
      allow delete: if isAdmin();

      // User files subcollection
      // ── Per-User Files Subcollection ────────────────────────────────────────
      match /files/{fileId} {
        allow read, write: if isOwner(userId) || isAdmin();
        // Both read and write require a verified account (owner or admin).
        // Unverified users cannot load, upload, rename, or trash their files.
        allow read, write: if isVerifiedOwner(userId);
      }
    }

    // Global files collection (for system overview, search, and shared file links)

    // ── Global Files Collection ───────────────────────────────────────────────
    // Used for system-wide search, shared file links, and admin overviews.
    match /files/{fileId} {
      // Read: any authenticated user can read (for shared link access).
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userUid == request.auth.uid || isAdmin());

      // Create: uploader must be verified and writing their own UID.
      allow create: if isEmailVerified() &&
                       request.resource.data.userUid == request.auth.uid;

      // Update / Delete: only the verified original uploader or admin.
      allow update, delete: if isEmailVerified() &&
                               (resource.data.userUid == request.auth.uid || isAdmin());
    }

    // Upgrade payment requests

    // ── Upgrade Payment Requests ──────────────────────────────────────────────
    match /upgradeRequests/{requestId} {
      allow create: if isAuthenticated();
      // Only verified users can submit upgrade/payment requests.
      allow create: if isEmailVerified();
      allow read, update, delete: if isAdmin();
    }

  }
}

