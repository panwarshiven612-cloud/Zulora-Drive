# Server
PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call a separately hosted API.
# CORS_ORIGINS=https://drive.example.com

# Keep this directory on a persistent, private server volume in production.
# UPLOAD_DIR=/srv/zulora-drive/uploads
MAX_FILE_SIZE_BYTES=524288000

# Configure ONE Firebase Admin credential option. Do not commit real credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
