rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownerOnCreate() {
      return signedIn() && request.resource.metadata.owner == request.auth.uid;
    }

    function ownerOnExisting() {
      return signedIn() && resource.metadata.owner == request.auth.uid &&
        request.resource.metadata.owner == request.auth.uid;
    }

    function allowedContentType() {
      return request.resource.contentType != null &&
        !request.resource.contentType.matches('(?i)(application/x-msdownload|application/x-bat|application/x-sh|application/x-httpd-php|application/javascript|text/javascript|text/html).*');
    }

    match /users/{userId}/{filePath=**} {
      allow create: if ownerOnCreate() &&
        request.auth.uid == userId &&
        request.resource.size <= 524288000 &&
        allowedContentType();
      allow read, update, delete: if ownerOnExisting() && request.auth.uid == userId;
    }
  }
}
